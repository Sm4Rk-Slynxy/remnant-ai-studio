      "height": 448,
      "length": 124,
      "first_frame": [
        "scene_start",
        0
      ],
      "last_frame": [
        "scene_end",
        0
      ]
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "shift",
        0
      ],
      "conditioning": [
        "conditioning",
        0
      ]
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "sigmas": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "shift",
        0
      ],
      "scheduler": "beta",
      "steps": 4,
      "denoise": 1
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sigmas",
        0
      ],
      "latent_image": [
        "conditioning",
        1
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 16,
      "temporal_overlap": 4
