      "image": "scene-start.png"
    }
  },
  "scene_end": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "scene-end.png"
    }
  },
  "conditioning": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "encoder",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "prompt": "Describe the action between the supplied first and last images.",
