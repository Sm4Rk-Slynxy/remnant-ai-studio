{
  "model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "turbo": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "model",
        0
      ],
      "lora_name": "minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors",
      "strength_model": 1
    }
  },
  "chunks": {
    "class_type": "MiniMaxChunkFeedForward",
    "inputs": {
      "model": [
        "turbo",
        0
      ],
      "chunks": 4,
      "seq_threshold": 2048
    }
  },
  "attention": {
    "class_type": "MiniMaxLowVRAMAttention",
    "inputs": {
      "model": [
        "chunks",
        0
      ],
      "head_chunks": 4
    }
  },
  "shift": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": [
        "attention",
        0
      ],
      "shift_video": 12,
      "shift_audio": 3
    }
  },
  "encoder": {
